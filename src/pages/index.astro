---
import Base from '../layouts/Base.astro';
import Spacetime from '../components/Spacetime.astro';
import Rings from '../components/Rings.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const p = (s = '') => `${base}/${s.replace(/^\//, '')}`.replace(/\/{2,}/g, '/');

const now = new Date();
const over = (e) => (e.data.endDate ?? e.data.date) < now;
const day = (d) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const projects = (await getCollection('projects', (e) => !e.data.draft))
  .sort((a, b) => b.data.year - a.data.year);
const events = await getCollection('events', (e) => !e.data.draft);

// Works sit on the cone, placed by year.
const works = projects.map((w) => ({
  href: p(`projects/${w.id}/`),
  title: w.data.title,
  meta: `${w.data.year} · project`,
  t: Math.max(-9, (w.data.year - now.getFullYear()) * 1.1 - 0.6),
}));

// Events ride the rings — a separate drawing, in separate coordinates.
const ride = (e) => ({ href: p('events/'), title: e.data.title, meta: `${e.data.city} · ${day(e.data.date)}` });
const soon = events.filter((e) => !over(e)).sort((a, b) => a.data.date - b.data.date).map(ride);
const done = events.filter(over).sort((a, b) => b.data.date - a.data.date).map(ride);
---

<Base title={null}>
  <div class="stage">
    <Spacetime works={works} href={p('projects/')} />
    <Rings soon={soon} done={done} href={p('events/')} />
  </div>
</Base>
