---
import Base from '../layouts/Base.astro';
import Dial from '../components/Dial.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const p = (s = '') => `${base}/${s.replace(/^\//, '')}`.replace(/\/{2,}/g, '/');
const now = new Date();

const projects = (await getCollection('projects', (e) => !e.data.draft))
  .sort((a, b) => b.data.year - a.data.year);
const covers = projects.filter((w) => w.data.cover).map((w) => ({ id: w.id, src: w.data.cover }));

const next = (await getCollection('events', (e) => !e.data.draft))
  .filter((e) => (e.data.endDate ?? e.data.date) >= now)
  .sort((a, b) => a.data.date - b.data.date)
  .slice(0, 3);

const fmt = (d) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title={null} covers={covers}>
  <p class="lede">
    Sound, installation, and instruments. Listening to plasma, seeds, radio, and
    the resonance of rooms.
  </p>

  {next.length > 0 && (
    <section class="upnext">
      <h2>Next</h2>
      <ul>
        {next.map((e) => (
          <li>
            <span class="when">{fmt(e.data.date)}</span>
            <span class="what">{e.data.title}</span>
            <span class="where">{e.data.venue}, {e.data.city}</span>
          </li>
        ))}
      </ul>
      <a class="more" href={p('events/')}>All events →</a>
    </section>
  )}

  <h2 class="eyebrow">Projects</h2>
  <Dial works={projects} />
</Base>
