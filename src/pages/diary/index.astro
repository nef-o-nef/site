---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const p = (s = '') => `${base}/${s.replace(/^\//, '')}`.replace(/\/{2,}/g, '/');
const posts = (await getCollection('diary', (e) => !e.data.draft))
  .sort((a, b) => b.data.date - a.data.date);
const fmt = (d) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="Diary">
  {posts.length === 0 && <p class="lede">Nothing written yet.</p>}
  <ul class="diary">
    {posts.map((e) => (
      <li>
        <a href={p(`diary/${e.id}/`)}>
          <time datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
          <span class="title">{e.data.title}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
