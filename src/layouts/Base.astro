---
import '../styles/global.css';

const { title, description = 'Nefo — sound, installation, and instruments.', covers = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const p = (s = '') => `${base}/${s.replace(/^\//, '')}`.replace(/\/{2,}/g, '/');
const here = Astro.url.pathname;

const nav = [
  { href: p('projects/'), label: 'Projects' },
  { href: p('events/'), label: 'Events' },
  { href: p('about/'), label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — NEFO` : 'NEFO'}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
  </head>
  <body>
    {covers.length > 0 && (
      <div class="backdrop">
        {covers.map((c) => <img src={p(c.src)} alt="" data-for={c.id} loading="lazy" />)}
      </div>
    )}

    <header class="masthead">
      <p class="wordmark"><a href={p()}>Nefo</a></p>
      <button class="trigger" id="trigger" aria-expanded="false" aria-controls="menu">
        <span></span><span></span><span></span>
      </button>
    </header>

    <div class="menu" id="menu" hidden>
      <nav>
        {nav.map((i) => (
          <a href={i.href} aria-current={here.startsWith(i.href) ? 'page' : undefined}>{i.label}</a>
        ))}
      </nav>
      <p class="menu-foot">Amsterdam · <a href="mailto:nefozhang@gmail.com">nefozhang@gmail.com</a></p>
    </div>

    <script>
      const trigger = document.getElementById('trigger');
      const menu = document.getElementById('menu');
      const set = (open) => {
        menu.hidden = !open;
        trigger.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('locked', open);
        if (open) menu.querySelector('a').focus();
      };
      trigger.addEventListener('click', () => set(menu.hidden));
      addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
      menu.addEventListener('click', (e) => e.target.closest('a') && set(false));
    </script>

    <main><slot /></main>

    <footer>Amsterdam · <a href="mailto:nefozhang@gmail.com">nefozhang@gmail.com</a></footer>
  </body>
</html>
